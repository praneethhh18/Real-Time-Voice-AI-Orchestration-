# Copy this file to `.env` and fill in your keys.

# --- LiveKit Cloud (https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram (STT + TTS) (https://console.deepgram.com) ---
DEEPGRAM_API_KEY=

# --- Groq (free LLM inference, OpenAI-compatible) (https://console.groq.com) ---
GROQ_API_KEY=

# --- App config (sensible defaults; only override if needed) ---
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
STT_MODEL=nova-2
TTS_MODEL=aura-asteria-en
RAG_TOP_K=4
DATA_DIR=./data
